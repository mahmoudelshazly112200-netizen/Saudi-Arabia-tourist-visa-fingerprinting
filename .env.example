# PORT: HTTP port for the Express server (defaults to 3000)
PORT="3000"

# APP_URL / SITE_URL: Public official custom domain URL used for canonical SEO tags, sitemap.xml, and robots.txt
APP_URL="https://sauditouristvisa.online"
SITE_URL="https://sauditouristvisa.online"
VITE_SITE_URL="https://sauditouristvisa.online"

# ADMIN_ACCESS_TOKEN: Optional secret token protecting /api/admin/* routes alongside Firebase JWT verification
ADMIN_ACCESS_TOKEN=""

# Optional override for Nashka Tourism Contact Channels (defaults to approved project numbers)
# Company Phone default: 01040009577
# Inquiry WhatsApp default: 01060070093
VITE_NASHKA_PHONE="01040009577"
VITE_NASHKA_WHATSAPP="201060070093"
VITE_NASHKA_EMAIL="nashkatourism@gmail.com"
